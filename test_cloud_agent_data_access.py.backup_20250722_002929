            {'name': '当日成交', 'endpoint': '/trades', 'method': 'GET', 'expected_data': ['trades', 'transactions']},
            {'name': '委托订单', 'endpoint': '/orders', 'method': 'GET', 'expected_data': ['orders', 'pending']},
            {'name': '历史记录', 'endpoint': '/history', 'method': 'GET', 'expected_data': ['history', 'records']},
            {'name': '资金流水', 'endpoint': '/funds', 'method': 'GET', 'expected_data': ['funds', 'cash_flow']},
