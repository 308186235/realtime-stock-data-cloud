            },
            {
                'name': '导出成交记录',
                'endpoint': '/export/trades',
                'params': {'format': 'json', 'start_date': (datetime.now() - timedelta(days=7)).strftime('%Y-%m-%d')}
            },
            {
                'name': '导出资金流水',
                'endpoint': '/export/funds',
                'params': {'format': 'csv', 'period': 'today'}
            },
            {
                'name': '导出完整报告',
                'endpoint': '/export/report',
                'params': {'format': 'json', 'type': 'daily'}
            }
        ]
        
        export_results = {}
        
        for export_test in export_tests:
            self.log(f"📋 测试: {export_test['name']}")
            
            # 测试云端导出访问
            try:
                start_time = time.perf_counter()
                
                response = self.session.post(
                    f"{self.config['cloud_trading']}{export_test['endpoint']}",
                    json=export_test['params'],
                    timeout=self.config['timeout']
                )
                
                latency = (time.perf_counter() - start_time) * 1000
                
                result = {
                    'success': response.status_code == 200,
                    'status_code': response.status_code,
                    'latency': round(latency, 2),
                    'response_size': len(response.content)
                }
                
                if response.status_code == 200:
                    # 检查响应内容类型
                    content_type = response.headers.get('content-type', '')
                    
                    if 'json' in content_type:
                        try:
                            data = response.json()
                            result['data_type'] = 'json'
                            result['data'] = data
                            
                            # 分析导出数据
                            if isinstance(data, dict) and 'export_file' in data:
                                self.log(f"   ✅ 导出成功: 文件 {data.get('export_file')}", "SUCCESS")
                            elif isinstance(data, list):
                                self.log(f"   ✅ 导出成功: {len(data)}条记录", "SUCCESS")
                            else:
                                self.log(f"   ✅ 导出成功: JSON数据", "SUCCESS")
                                
                        except json.JSONDecodeError:
                            result['data_type'] = 'text'
                            result['data'] = response.text[:200]
                            self.log(f"   ✅ 导出成功: 文本数据", "SUCCESS")
                    
                    elif 'csv' in content_type:
                        result['data_type'] = 'csv'
                        result['data'] = response.text[:500]  # CSV样本
                        
                        # 分析CSV行数
                        lines = response.text.split('\n')
                        self.log(f"   ✅ 导出成功: CSV文件，{len(lines)}行", "SUCCESS")
                    
                    else:
                        result['data_type'] = 'binary'
                        self.log(f"   ✅ 导出成功: 二进制文件，{len(response.content)}字节", "SUCCESS")
                    
                    self.log(f"   ⏱️ 导出耗时: {round(latency, 2)}ms", "INFO")
                    
                else:
                    result['error'] = f"HTTP {response.status_code}"
                    self.log(f"   ❌ 导出失败: 状态码 {response.status_code}", "ERROR")
                
                export_results[export_test['name']] = result
                
            except Exception as e:
