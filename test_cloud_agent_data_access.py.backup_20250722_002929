                    'success': False,
                    'error': str(e)
                }
                self.log(f"   ❌ 导出异常: {e}", "ERROR")
            
            time.sleep(1)  # 间隔1秒
        
        self.test_results['export_functionality'] = export_results
        return export_results
    
    def test_real_time_data_access(self):
        """测试实时数据访问"""
        self.log("📡 测试实时数据访问...")
        
        realtime_tests = [
            {'name': '实时行情', 'endpoint': '/realtime/quotes'},
            {'name': '实时成交', 'endpoint': '/realtime/trades'},
            {'name': '实时资金', 'endpoint': '/realtime/funds'},
            {'name': '实时持仓', 'endpoint': '/realtime/positions'}
        ]
        
        realtime_results = {}
        
        for test in realtime_tests:
            self.log(f"📊 测试: {test['name']}")
            
            # 连续获取几次数据，检查实时性
            data_snapshots = []
            
            for i in range(3):
                try:
                    response = self.session.get(
                        f"{self.config['cloud_trading']}{test['endpoint']}",
                        timeout=10
                    )
                    
                    if response.status_code == 200:
                        try:
                            data = response.json()
                            data_snapshots.append({
                                'timestamp': datetime.now().isoformat(),
                                'data': data,
                                'size': len(response.content)
                            })
                            
                            self.log(f"   📸 快照{i+1}: {len(response.content)}字节", "SUCCESS")
                            
                        except json.JSONDecodeError:
                            data_snapshots.append({
                                'timestamp': datetime.now().isoformat(),
                                'data': response.text[:100],
                                'size': len(response.content)
                            })
                    
                    time.sleep(2)  # 间隔2秒
                    
                except Exception as e:
                    self.log(f"   ❌ 快照{i+1}失败: {e}", "ERROR")
            
            # 分析数据变化
            if len(data_snapshots) >= 2:
                # 检查数据是否有变化
                data_changed = False
                for i in range(1, len(data_snapshots)):
                    if data_snapshots[i]['data'] != data_snapshots[i-1]['data']:
                        data_changed = True
                        break
                
                realtime_results[test['name']] = {
                    'success': len(data_snapshots) > 0,
                    'snapshots': len(data_snapshots),
                    'data_changed': data_changed,
                    'avg_size': sum(s['size'] for s in data_snapshots) / len(data_snapshots)
                }
                
                if data_changed:
                    self.log(f"   ✅ 数据实时更新: 检测到变化", "SUCCESS")
                else:
                    self.log(f"   ⚠️ 数据可能静态: 未检测到变化", "WARNING")
            else:
                realtime_results[test['name']] = {
                    'success': False,
                    'error': 'insufficient_data'
                }
        
        self.test_results['realtime_data'] = realtime_results
        return realtime_results
    
    async def test_websocket_data_stream(self):
        """测试WebSocket数据流"""
        self.log("🌐 测试WebSocket数据流...")
        
        try:
            async with websockets.connect(self.config['cloud_ws']) as websocket:
                self.log("✅ WebSocket连接建立", "SUCCESS")
                
                # 订阅数据流
                subscribe_messages = [
                    {'type': 'subscribe', 'channel': 'trades'},
                    {'type': 'subscribe', 'channel': 'positions'},
                    {'type': 'subscribe', 'channel': 'balance'},
                    {'type': 'subscribe', 'channel': 'orders'}
                ]
                
                for msg in subscribe_messages:
                    await websocket.send(json.dumps(msg))
                    self.log(f"📤 订阅: {msg['channel']}", "INFO")
                
                # 监听数据流
                received_data = []
                timeout_count = 0
                max_timeout = 5
                
                while timeout_count < max_timeout:
                    try:
                        message = await asyncio.wait_for(websocket.recv(), timeout=2)
                        data = json.loads(message)
                        received_data.append({
                            'timestamp': datetime.now().isoformat(),
                            'data': data
                        })
                        
                        self.log(f"📥 收到数据: {data.get('type', 'unknown')}", "SUCCESS")
                        timeout_count = 0  # 重置超时计数
                        
                    except asyncio.TimeoutError:
                        timeout_count += 1
                        self.log(f"⏰ 等待数据... ({timeout_count}/{max_timeout})", "INFO")
                
                ws_result = {
                    'success': len(received_data) > 0,
                    'messages_received': len(received_data),
                    'data_types': list(set(msg['data'].get('type', 'unknown') for msg in received_data))
                }
                
                if received_data:
                    self.log(f"✅ WebSocket数据流: 收到{len(received_data)}条消息", "SUCCESS")
                else:
                    self.log("⚠️ WebSocket数据流: 未收到数据", "WARNING")
                
                self.test_results['websocket_stream'] = ws_result
                return ws_result
                
        except Exception as e:
            self.log(f"❌ WebSocket测试失败: {e}", "ERROR")
            self.test_results['websocket_stream'] = {'success': False, 'error': str(e)}
            return {'success': False, 'error': str(e)}
    
    def analyze_data_accessibility(self):
        """分析数据可访问性"""
        self.log("📊 分析数据可访问性...")
        
        accessibility_summary = {
            'basic_data_accessible': 0,
            'export_functions_working': 0,
            'realtime_data_available': 0,
            'websocket_streaming': False,
            'total_endpoints_tested': 0,
            'successful_endpoints': 0
        }
        
        # 分析基础数据端点
        basic_data = self.test_results.get('basic_data_endpoints', {})
        for name, result in basic_data.items():
            accessibility_summary['total_endpoints_tested'] += 1
            if result.get('cloud_accessible', False):
                accessibility_summary['successful_endpoints'] += 1
                accessibility_summary['basic_data_accessible'] += 1
        
        # 分析导出功能
        export_data = self.test_results.get('export_functionality', {})
        for name, result in export_data.items():
            if result.get('success', False):
                accessibility_summary['export_functions_working'] += 1
        
        # 分析实时数据
        realtime_data = self.test_results.get('realtime_data', {})
        for name, result in realtime_data.items():
            if result.get('success', False):
                accessibility_summary['realtime_data_available'] += 1
        
        # 分析WebSocket
        ws_data = self.test_results.get('websocket_stream', {})
        accessibility_summary['websocket_streaming'] = ws_data.get('success', False)
        
        # 计算成功率
        if accessibility_summary['total_endpoints_tested'] > 0:
            success_rate = (accessibility_summary['successful_endpoints'] / 
                          accessibility_summary['total_endpoints_tested']) * 100
            accessibility_summary['success_rate'] = round(success_rate, 1)
        else:
            accessibility_summary['success_rate'] = 0
        
        self.test_results['accessibility_summary'] = accessibility_summary
        return accessibility_summary
    
