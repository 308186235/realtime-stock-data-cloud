    def test_endpoint_access(self, access_type, url, method):
        """测试端点访问"""
        try:
            start_time = time.perf_counter()
            
            if method == 'GET':
                response = self.session.get(url, timeout=self.config['timeout'])
            elif method == 'POST':
                response = self.session.post(url, json={}, timeout=self.config['timeout'])
            else:
                return {'success': False, 'error': f'Unsupported method: {method}'}
            
            latency = (time.perf_counter() - start_time) * 1000
            
            result = {
                'success': response.status_code == 200,
                'status_code': response.status_code,
                'latency': round(latency, 2),
                'response_size': len(response.content)
            }
            
            if response.status_code == 200:
                try:
                    data = response.json()
                    result['data'] = data
                    result['data_type'] = 'json'
                    result['data_keys'] = list(data.keys()) if isinstance(data, dict) else []
                    
                    self.log(f"   ✅ {access_type}访问: {round(latency, 2)}ms, 数据大小: {len(response.content)}字节", "SUCCESS")
                    
                except json.JSONDecodeError:
                    result['data'] = response.text[:500]  # 只保存前500字符
                    result['data_type'] = 'text'
                    
                    self.log(f"   ✅ {access_type}访问: {round(latency, 2)}ms, 文本数据", "SUCCESS")
            else:
                result['error'] = f"HTTP {response.status_code}"
                self.log(f"   ❌ {access_type}访问: 状态码 {response.status_code}", "ERROR")
            
            return result
            
        except requests.exceptions.Timeout:
            self.log(f"   ⏰ {access_type}访问: 超时", "WARNING")
            return {'success': False, 'error': 'timeout', 'latency': self.config['timeout'] * 1000}
        
        except Exception as e:
            self.log(f"   ❌ {access_type}访问: 失败 - {e}", "ERROR")
            return {'success': False, 'error': str(e)}
    
    def analyze_data_content(self, endpoint_name, data, expected_fields):
        """分析数据内容"""
        if isinstance(data, dict):
            available_fields = list(data.keys())
            
            # 检查是否包含预期字段
            found_expected = []
            for expected in expected_fields:
                for available in available_fields:
                    if expected.lower() in available.lower():
                        found_expected.append(available)
                        break
            
            if found_expected:
                self.log(f"   📋 包含预期数据: {found_expected}", "SUCCESS")
            else:
                self.log(f"   ⚠️ 未找到预期字段，可用字段: {available_fields}", "WARNING")
            
            # 检查数据量
            if isinstance(data, dict):
                total_items = 0
                for key, value in data.items():
                    if isinstance(value, list):
                        total_items += len(value)
                        self.log(f"   📊 {key}: {len(value)}条记录", "INFO")
                    elif isinstance(value, (int, float)):
                        self.log(f"   💰 {key}: {value}", "INFO")
                
                if total_items > 0:
                    self.log(f"   📈 总数据量: {total_items}条记录", "SUCCESS")
        
        elif isinstance(data, list):
            self.log(f"   📊 数组数据: {len(data)}条记录", "SUCCESS")
            if len(data) > 0 and isinstance(data[0], dict):
                sample_keys = list(data[0].keys())
                self.log(f"   🔍 样本字段: {sample_keys}", "INFO")
    
