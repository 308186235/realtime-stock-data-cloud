    def test_cdn_acceleration(self):
        """测试CDN加速方案"""
        self.log("🚀 测试CDN加速方案...")
        
        cdn_solutions = {
            'jsdelivr': {
                'name': 'JSDelivr CDN',
                'url': 'https://cdn.jsdelivr.net',
                'region': 'Global',
                'features': ['免费', '全球CDN', '高可用'],
                'use_case': '静态资源加速'
            },
            'bootcdn': {
                'name': 'BootCDN',
                'url': 'https://cdn.bootcdn.net',
                'region': 'China',
                'features': ['国内优化', '速度快', '免费'],
                'use_case': '中国大陆加速'
            },
            'staticfile': {
                'name': 'StaticFile CDN',
                'url': 'https://cdn.staticfile.org',
                'region': 'China',
                'features': ['七牛云', '国内节点', '免费'],
                'use_case': '静态文件加速'
            },
            'unpkg': {
                'name': 'unpkg CDN',
                'url': 'https://unpkg.com',
                'region': 'Global',
                'features': ['npm包', '自动更新', '免费'],
                'use_case': 'npm包加速'
            }
        }
        
        # 并发测试CDN延迟
        cdn_latencies = {}
        
        def test_cdn_latency(cdn_name, cdn_info):
            try:
                start_time = time.time()
                response = requests.get(f"{cdn_info['url']}/npm/vue@3/dist/vue.global.js", 
                                      timeout=10, stream=True)
                # 只读取前1KB来测试连接速度
                response.raw.read(1024)
                latency = round((time.time() - start_time) * 1000)
                return cdn_name, latency, True
            except Exception as e:
                return cdn_name, 9999, False
        
        with concurrent.futures.ThreadPoolExecutor(max_workers=4) as executor:
            futures = [executor.submit(test_cdn_latency, name, info) 
                      for name, info in cdn_solutions.items()]
            
            for future in concurrent.futures.as_completed(futures):
                cdn_name, latency, success = future.result()
                cdn_latencies[cdn_name] = {
                    'latency': latency,
                    'success': success
                }
                
                if success:
                    self.log(f"✅ {cdn_solutions[cdn_name]['name']}: {latency}ms", "SUCCESS")
                else:
                    self.log(f"❌ {cdn_solutions[cdn_name]['name']}: 失败", "ERROR")
        
        # 排序CDN
        sorted_cdns = sorted(cdn_latencies.items(), key=lambda x: x[1]['latency'])
        
        self.solutions['cdns'] = cdn_solutions
        self.test_results['cdn_latencies'] = cdn_latencies
        self.test_results['best_cdn'] = sorted_cdns[0] if sorted_cdns else None
        
        return cdn_solutions
    
    def test_dns_optimization(self):
        """测试DNS优化方案"""
        self.log("🔍 测试DNS优化方案...")
        
        dns_servers = {
            'cloudflare': {'ip': '1.1.1.1', 'name': 'Cloudflare DNS'},
            'google': {'ip': '8.8.8.8', 'name': 'Google DNS'},
            'quad9': {'ip': '9.9.9.9', 'name': 'Quad9 DNS'},
            'aliyun': {'ip': '223.5.5.5', 'name': '阿里云DNS'},
            'tencent': {'ip': '119.29.29.29', 'name': '腾讯DNS'},
            'baidu': {'ip': '180.76.76.76', 'name': '百度DNS'}
        }
        
        dns_results = {}
        
        for dns_key, dns_info in dns_servers.items():
            try:
                start_time = time.time()
                # 使用nslookup测试DNS解析速度
                result = subprocess.run(
                    ['nslookup', 'aigupiao.me', dns_info['ip']], 
                    capture_output=True, text=True, timeout=5
                )
                latency = round((time.time() - start_time) * 1000)
                
                dns_results[dns_key] = {
                    'name': dns_info['name'],
                    'ip': dns_info['ip'],
                    'latency': latency,
                    'success': result.returncode == 0
                }
                
                if result.returncode == 0:
                    self.log(f"✅ {dns_info['name']}: {latency}ms", "SUCCESS")
                else:
                    self.log(f"❌ {dns_info['name']}: 失败", "ERROR")
                    
            except Exception as e:
                dns_results[dns_key] = {
                    'name': dns_info['name'],
                    'ip': dns_info['ip'],
                    'latency': 9999,
                    'success': False,
                    'error': str(e)
                }
                self.log(f"❌ {dns_info['name']}: 异常 - {e}", "ERROR")
        
        # 找出最快的DNS
        best_dns = min(dns_results.items(), key=lambda x: x[1]['latency'] if x[1]['success'] else 9999)
        
        self.solutions['dns'] = dns_servers
        self.test_results['dns_results'] = dns_results
        self.test_results['best_dns'] = best_dns
        
        return dns_results
    
    def test_network_routes(self):
        """测试网络路由优化"""
        self.log("🛣️ 测试网络路由...")
        
        # 测试到不同地区的延迟
        test_targets = {
            'cloudflare_hk': '104.16.132.229',  # Cloudflare香港
            'cloudflare_sg': '104.16.133.229',  # Cloudflare新加坡
            'cloudflare_jp': '104.16.134.229',  # Cloudflare日本
            'aliyun_hk': '47.52.104.15',        # 阿里云香港
            'tencent_hk': '119.28.51.30',       # 腾讯云香港
            'aws_sg': '52.77.250.224'           # AWS新加坡
        }
        
        route_results = {}
        
        for target_name, target_ip in test_targets.items():
            try:
                result = subprocess.run(
                    ['ping', '-n', '4', target_ip], 
                    capture_output=True, text=True, timeout=30
                )
                
                if result.returncode == 0 and "平均 =" in result.stdout:
                    avg_line = [line for line in result.stdout.split('\n') if '平均 =' in line][0]
                    avg_time = avg_line.split('平均 = ')[1].replace('ms', '').strip()
                    
                    route_results[target_name] = {
                        'ip': target_ip,
                        'latency': int(avg_time),
                        'success': True
                    }
                    self.log(f"✅ {target_name} ({target_ip}): {avg_time}ms", "SUCCESS")
                else:
                    route_results[target_name] = {
                        'ip': target_ip,
                        'latency': 9999,
                        'success': False
                    }
                    self.log(f"❌ {target_name} ({target_ip}): 失败", "ERROR")
                    
            except Exception as e:
                route_results[target_name] = {
                    'ip': target_ip,
                    'latency': 9999,
                    'success': False,
                    'error': str(e)
                }
                self.log(f"❌ {target_name}: 异常 - {e}", "ERROR")
        
        self.test_results['route_results'] = route_results
        return route_results
    
