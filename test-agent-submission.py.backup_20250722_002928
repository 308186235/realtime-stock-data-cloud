    def test_local_api(self):
        """测试本地API服务"""
        try:
            # 测试状态端点
            response = requests.get(f"{self.local_api}/status", timeout=5)
            
            if response.status_code == 200:
                status_data = response.json()
                print("✅ 本地API服务器运行正常")
                print(f"   📊 服务状态: {'运行中' if status_data.get('service_running') else '停止'}")
                print(f"   🔗 WebSocket: {'已连接' if status_data.get('websocket_connected') else '未连接'}")
                print(f"   🔧 交易API: {'可用' if status_data.get('trader_api_available') else '不可用'}")
                
                # 测试导出端点
                export_data = {"data_type": "test", "timestamp": datetime.now().isoformat()}
                export_response = requests.post(f"{self.local_api}/export", json=export_data, timeout=10)
                
                if export_response.status_code in [200, 503]:  # 503是预期的（交易API不可用）
                    print("✅ 导出端点响应正常")
                    return {
                        "status": "success",
                        "message": "本地API服务正常",
                        "api_status": status_data
                    }
                else:
                    print(f"⚠️ 导出端点异常: HTTP {export_response.status_code}")
                    return {
                        "status": "partial",
                        "message": f"导出端点异常: {export_response.status_code}",
                        "api_status": status_data
                    }
            else:
                print(f"❌ 本地API异常: HTTP {response.status_code}")
                return {
                    "status": "error",
                    "message": f"API异常: {response.status_code}",
                    "api_status": None
                }
                
        except requests.exceptions.ConnectionError:
            print("❌ 本地API服务器未启动")
            return {
                "status": "error",
                "message": "API服务器未启动",
                "api_status": None
            }
        except Exception as e:
            print(f"❌ 本地API测试异常: {e}")
            return {
                "status": "error",
                "message": f"测试异常: {e}",
                "api_status": None
            }
    
