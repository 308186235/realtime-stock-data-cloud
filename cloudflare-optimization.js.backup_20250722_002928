 * 3. 动态切换最优路径
 * 4. 本地DNS劫持
 */

const https = require('https');
const dns = require('dns');

// 已知的Cloudflare优选IP列表（中国大陆优化）
const OPTIMIZED_IPS = [
  // 香港节点（通常最快）
  '104.16.132.229',
  '104.16.133.229', 
  '172.67.74.226',
  '104.21.48.84',
  
  // 新加坡节点
  '104.18.24.2',
  '104.18.25.2',
  '172.67.136.89',
  '104.21.72.223',
  
  // 日本节点
