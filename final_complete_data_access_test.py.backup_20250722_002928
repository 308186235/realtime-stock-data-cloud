                    value = data[field]
                    if isinstance(value, list):
                        self.log(f"     📊 {field}: {len(value)}项", "INFO")
                    elif isinstance(value, (int, float)):
                        self.log(f"     💰 {field}: {value}", "INFO")
                    elif isinstance(value, str):
                        self.log(f"     📋 {field}: {value}", "INFO")
    
