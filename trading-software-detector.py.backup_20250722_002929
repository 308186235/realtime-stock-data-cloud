class TradingSoftwareDetector:
    def __init__(self):
        self.trading_processes = []
        self.trading_windows = []
        self.detected_interfaces = []
        
    def detect_trading_processes(self):
        """检测可能的交易软件进程"""
        trading_keywords = [
            '同花顺', 'tonghuashun', 'ths',
            '东方财富', 'eastmoney', 'em',
            '大智慧', 'dzh', 'gw',
            '华泰', 'htsc',
            '中信', 'citic',
            '招商', 'cmschina',
            '国泰君安', 'gtja',
            '广发', 'gf',
            '海通', 'htsec',
            'trader', 'trading', 'stock'
        ]
        
        print("🔍 检测交易软件进程...")
        for proc in psutil.process_iter(['pid', 'name', 'exe']):
            try:
                proc_name = proc.info['name'].lower()
                proc_exe = proc.info['exe'] or ''
                
                for keyword in trading_keywords:
                    if keyword in proc_name or keyword in proc_exe.lower():
                        self.trading_processes.append({
                            'pid': proc.info['pid'],
                            'name': proc.info['name'],
                            'exe': proc_exe,
                            'keyword': keyword
                        })
                        print(f"  ✅ 发现交易软件: {proc.info['name']} (PID: {proc.info['pid']})")
                        break
                        
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                continue
                
        return self.trading_processes
    
    def detect_trading_windows(self):
        """检测交易软件窗口"""
        print("\n🪟 检测交易软件窗口...")
        
        def enum_windows_callback(hwnd, windows):
            if win32gui.IsWindowVisible(hwnd):
                window_text = win32gui.GetWindowText(hwnd)
                class_name = win32gui.GetClassName(hwnd)
                
                trading_window_keywords = [
                    '交易', '买卖', '委托', '持仓', '资金',
                    '同花顺', '东方财富', '大智慧', '华泰',
                    'trading', 'trader', 'stock'
                ]
                
                for keyword in trading_window_keywords:
                    if keyword in window_text or keyword in class_name:
                        try:
                            _, pid = win32process.GetWindowThreadProcessId(hwnd)
                            windows.append({
                                'hwnd': hwnd,
                                'title': window_text,
                                'class': class_name,
                                'pid': pid
                            })
                            print(f"  ✅ 发现交易窗口: {window_text} ({class_name})")
                            break
                        except:
                            pass
            return True
        
        win32gui.EnumWindows(enum_windows_callback, self.trading_windows)
        return self.trading_windows
    
    def check_api_interfaces(self):
        """检查可能的API接口"""
        print("\n🔌 检查API接口...")
        
        # 检查常见的交易API端口
        api_ports = [7708, 7709, 8080, 8888, 9999, 18080]
        
        import socket
        for port in api_ports:
            try:
                sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                sock.settimeout(1)
                result = sock.connect_ex(('127.0.0.1', port))
                sock.close()
                
                if result == 0:
                    print(f"  ✅ 发现开放端口: {port}")
                    self.detected_interfaces.append({
                        'type': 'tcp_port',
                        'port': port,
                        'status': 'open'
                    })
            except:
                pass
    
    def check_dde_support(self):
        """检查DDE支持"""
        print("\n📡 检查DDE支持...")
        try:
            import dde
            print("  ✅ DDE模块可用")
            self.detected_interfaces.append({
                'type': 'dde',
                'status': 'available'
            })
        except ImportError:
            print("  ❌ DDE模块不可用，需要安装: pip install pywin32")
    
    def analyze_window_controls(self, hwnd):
        """分析窗口控件结构"""
        print(f"\n🎛 分析窗口控件: {win32gui.GetWindowText(hwnd)}")
        
        controls = []
        
        def enum_child_windows(child_hwnd, controls_list):
            try:
                class_name = win32gui.GetClassName(child_hwnd)
                window_text = win32gui.GetWindowText(child_hwnd)
                rect = win32gui.GetWindowRect(child_hwnd)
                
                # 查找可能的交易相关控件
                trading_controls = ['买入', '卖出', '委托', '撤单', 'Button', 'Edit']
                
                for control_type in trading_controls:
                    if control_type in class_name or control_type in window_text:
                        controls_list.append({
                            'hwnd': child_hwnd,
                            'class': class_name,
                            'text': window_text,
                            'rect': rect
                        })
                        print(f"    🎯 发现控件: {window_text} ({class_name}) at {rect}")
                        break
                        
            except:
                pass
            return True
        
        try:
            win32gui.EnumChildWindows(hwnd, enum_child_windows, controls)
        except:
            pass
            
        return controls
    
