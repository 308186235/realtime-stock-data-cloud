    def run_detection(self):
        """运行完整检测"""
        print("🚀 开始检测交易软件接口...\n")
        
        # 检测进程
        processes = self.detect_trading_processes()
        
        # 检测窗口
        windows = self.detect_trading_windows()
        
        # 检查API接口
        self.check_api_interfaces()
        
        # 检查DDE支持
        self.check_dde_support()
        
        # 分析主要交易窗口的控件
        for window in windows[:2]:  # 只分析前2个窗口
            controls = self.analyze_window_controls(window['hwnd'])
            window['controls'] = controls
        
        # 生成报告
        report = {
            'timestamp': datetime.now().isoformat(),
            'processes': processes,
            'windows': windows,
            'interfaces': self.detected_interfaces,
            'recommendations': self.generate_recommendations()
