    def generate_report(self, results):
        """生成测试报告"""
        print("📊 策略集成测试总结")
        print("=" * 60)
        
        # 统计成功率
        total_tests = len(results)
        successful_tests = sum(1 for result in results.values() if result.get("success", False))
        success_rate = (successful_tests / total_tests * 100) if total_tests > 0 else 0
        
        print(f"\n📈 策略集成成功率: {success_rate:.1f}% ({successful_tests}/{total_tests})")
        
        # 详细结果
        print(f"\n📋 详细测试结果:")
        test_names = {
            "technical_indicators": "技术指标策略",
            "six_sword_strategy": "六脉神剑策略",
            "jiufang_strategy": "九方智投策略",
            "compass_strategy": "指南针策略",
            "limit_up_strategy": "涨停双阴策略",
            "candle_patterns": "K线形态识别",
            "volume_price": "量价关系分析",
            "strategy_integration": "策略整合"
        }
        
        for test_key, result in results.items():
            test_name = test_names.get(test_key, test_key)
            status = "✅" if result.get("success") else "❌"
            coverage = result.get("coverage", 0)
            print(f"   {status} {test_name} (覆盖率: {coverage:.1f}%)")
        
        # 总体评估
        print(f"\n🏆 总体评估:")
        if success_rate >= 90:
            grade = "A+ 优秀"
            status = "🎉 所有策略完美集成，系统功能完整"
        elif success_rate >= 75:
            grade = "A 良好"
            status = "✅ 大部分策略已集成，系统基本完整"
        elif success_rate >= 50:
            grade = "B 一般"
            status = "⚠️ 部分策略已集成，需要继续完善"
        else:
            grade = "C 需要改进"
            status = "❌ 策略集成不完整，需要大量工作"
        
        print(f"   等级: {grade}")
        print(f"   状态: {status}")
        
        # 策略亮点
        print(f"\n🎊 策略集成亮点:")
        successful_strategies = [name for name, result in results.items() if result.get("success")]
        
        if "technical_indicators" in successful_strategies:
            print(f"   📊 技术指标完整 - RSI、MACD、KDJ、布林带等")
        if "six_sword_strategy" in successful_strategies:
            print(f"   ⚔️ 六脉神剑完整 - 天地人和顺凌六大策略")
        if "jiufang_strategy" in successful_strategies:
            print(f"   🎲 九方智投完整 - 尾盘长下影阳线选股")
        if "compass_strategy" in successful_strategies:
            print(f"   🧭 指南针策略完整 - 七种市场分析策略")
        if "candle_patterns" in successful_strategies:
            print(f"   📈 K线形态完整 - 十多种经典形态识别")
        if "volume_price" in successful_strategies:
            print(f"   💰 量价分析完整 - 资金流向和量价配合")
        if "strategy_integration" in successful_strategies:
            print(f"   🔄 策略整合完整 - 多策略智能融合决策")

