#!/usr/bin/env python3
"""
配置ngrok + Cloudflare混合方案
获取ngrok地址并配置Cloudflare DNS
"""

import requests
import json
import time
import subprocess
from datetime import datetime

class NgrokCloudflareConfigurator:
    def __init__(self):
        self.ngrok_api_url = "http://localhost:4040/api/tunnels"
        self.tunnels = {}
        
    def log(self, message, level="INFO"):
        """记录日志"""
        timestamp = datetime.now().strftime("%H:%M:%S")
        colors = {
            "INFO": "\033[36m",
            "SUCCESS": "\033[32m",
            "WARNING": "\033[33m",
            "ERROR": "\033[31m",
            "RESET": "\033[0m"
        }
        color = colors.get(level, colors["INFO"])
        print(f"{color}[{timestamp}] [{level}] {message}{colors['RESET']}")
    
    def get_ngrok_tunnels(self):
        """获取ngrok隧道信息"""
        self.log("🔍 获取ngrok隧道信息...")
        
        try:
            response = requests.get(self.ngrok_api_url, timeout=10)
            if response.status_code == 200:
                data = response.json()
                tunnels = data.get('tunnels', [])
                
                for tunnel in tunnels:
                    name = tunnel.get('name', 'unknown')
                    public_url = tunnel.get('public_url', '')
                    local_addr = tunnel.get('config', {}).get('addr', '')
                    proto = tunnel.get('proto', '')
                    
                    if public_url.startswith('https://'):
                        self.tunnels[name] = {
                            'public_url': public_url,
                            'local_addr': local_addr,
                            'proto': proto,
                            'domain': public_url.replace('https://', '').replace('http://', '')
                        }
                        
                        self.log(f"✅ 发现隧道: {name}", "SUCCESS")
                        self.log(f"   公网地址: {public_url}", "INFO")
                        self.log(f"   本地地址: {local_addr}", "INFO")
                
                if not self.tunnels:
                    self.log("⚠️ 未发现HTTPS隧道", "WARNING")
                    return False
                
                return True
                
            else:
                self.log(f"❌ ngrok API响应错误: {response.status_code}", "ERROR")
                return False
                
        except requests.exceptions.ConnectionError:
            self.log("❌ 无法连接到ngrok API (端口4040)", "ERROR")
            self.log("💡 请确保ngrok正在运行", "INFO")
            return False
        except Exception as e:
            self.log(f"❌ 获取ngrok信息失败: {e}", "ERROR")
            return False
    
    def test_ngrok_performance(self):
        """测试ngrok隧道性能"""
        self.log("⚡ 测试ngrok隧道性能...")
        
        performance_results = {}
        
        for name, tunnel in self.tunnels.items():
            try:
                self.log(f"🧪 测试隧道: {name}")
                
                start_time = time.time()
                response = requests.get(f"{tunnel['public_url']}/health", timeout=15)
                latency = round((time.time() - start_time) * 1000)
                
                performance_results[name] = {
                    'latency': latency,
                    'status_code': response.status_code,
                    'success': response.status_code == 200,
                    'url': tunnel['public_url']
                }
                
                if response.status_code == 200:
                    self.log(f"✅ {name}: {latency}ms", "SUCCESS")
                else:
                    self.log(f"⚠️ {name}: {latency}ms (状态码: {response.status_code})", "WARNING")
                    
            except Exception as e:
                performance_results[name] = {
                    'latency': 9999,
                    'success': False,
                    'error': str(e),
                    'url': tunnel['public_url']
                }
                self.log(f"❌ {name}: 失败 - {e}", "ERROR")
            
            time.sleep(1)
        
        return performance_results
    
    def generate_cloudflare_dns_config(self):
        """生成Cloudflare DNS配置建议"""
        self.log("📋 生成Cloudflare DNS配置...")
        
        if not self.tunnels:
            self.log("❌ 没有可用的ngrok隧道", "ERROR")
            return None
        
        # 选择最佳隧道（通常是端口8000的API服务）
        best_tunnel = None
        for name, tunnel in self.tunnels.items():
            if '8000' in tunnel['local_addr'] or 'api' in name.lower():
                best_tunnel = tunnel
                break
        
        if not best_tunnel:
            # 如果没找到API隧道，使用第一个
            best_tunnel = list(self.tunnels.values())[0]
        
        dns_config = {
            'domain': 'aigupiao.me',
            'records': [
                {
                    'type': 'CNAME',
                    'name': 'api',
                    'content': best_tunnel['domain'],
                    'ttl': 300,
                    'comment': f'ngrok隧道 - {datetime.now().strftime("%Y-%m-%d %H:%M")}'
                }
            ],
            'ngrok_url': best_tunnel['public_url'],
            'local_addr': best_tunnel['local_addr']
        }
        
        self.log("📄 DNS配置建议:", "SUCCESS")
        self.log(f"   域名: api.aigupiao.me", "INFO")
        self.log(f"   类型: CNAME", "INFO")
        self.log(f"   目标: {best_tunnel['domain']}", "INFO")
        self.log(f"   TTL: 300秒", "INFO")
        
        return dns_config
    
    def create_test_script(self, dns_config):
        """创建测试脚本"""
        self.log("📝 创建测试脚本...")
        
        test_script = f"""#!/usr/bin/env python3
