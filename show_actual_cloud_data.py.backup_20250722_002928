#!/usr/bin/env python3
"""
直接展示云端Agent实际获取到的数据
不做任何美化，原样显示真实数据
"""

import requests
import json
from datetime import datetime

def show_raw_data():
    """显示原始数据"""
    cloud_url = "https://32db9fd9f6e2.ngrok-free.app"
    
    print("=" * 80)
    print("🔍 云端Agent实际获取的原始数据")
    print("=" * 80)
    print(f"云端地址: {cloud_url}")
    print(f"测试时间: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
    print()
    
    # 测试各个端点
    endpoints = [
        {'name': '服务信息', 'path': '/'},
        {'name': '健康检查', 'path': '/health'},
        {'name': '服务状态', 'path': '/status'},
        {'name': '账户余额', 'path': '/balance'},
        {'name': '持仓信息', 'path': '/positions'},
        {'name': '成交记录', 'path': '/trades'}
    ]
    
    session = requests.Session()
    
    for endpoint in endpoints:
        print(f"📋 {endpoint['name']} ({endpoint['path']}):")
        print("-" * 60)
        
        try:
            response = session.get(f"{cloud_url}{endpoint['path']}", timeout=15)
            
            print(f"HTTP状态码: {response.status_code}")
            print(f"响应大小: {len(response.content)}字节")
            
            if response.status_code == 200:
                try:
                    data = response.json()
                    print("原始JSON数据:")
                    print(json.dumps(data, indent=2, ensure_ascii=False))
                except json.JSONDecodeError:
                    print("响应内容（非JSON）:")
                    print(response.text[:500])
            else:
                print(f"错误响应: {response.text[:200]}")
                
        except Exception as e:
            print(f"请求异常: {e}")
        
        print()
        print("=" * 80)
        print()

if __name__ == "__main__":
    show_raw_data()
