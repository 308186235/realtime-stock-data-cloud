#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
测试Agent数据提交系统
验证从交易软件导出数据到Agent系统的完整流程
"""

import sys
import os
import json
import requests
import time
from datetime import datetime

# 添加stock-trading-backend到路径
sys.path.append(os.path.join(os.path.dirname(__file__), 'stock-trading-backend'))

class AgentDataSubmissionTester:
    def __init__(self):
        self.local_api = "http://localhost:8000"
        self.cloud_api = "https://api.aigupiao.me"
        
    def test_local_export_system(self):
        """测试本地导出系统"""
        print("🔍 测试本地导出系统...")
        print("=" * 50)
        
        try:
            # 导入交易导出模块
            from trader_export import export_holdings, export_transactions, export_orders, export_all_data
            print("✅ 交易导出模块导入成功")
            
            # 测试各个导出函数
            export_functions = {
                "持仓数据": export_holdings,
                "成交数据": export_transactions,
                "委托数据": export_orders,
                "全部数据": export_all_data
            }
            
            results = {}
            for name, func in export_functions.items():
                print(f"   📊 {name}导出函数: {func.__name__} ✅")
                results[name] = "✅ 可用"
            
            return results
            
        except ImportError as e:
            print(f"❌ 导入失败: {e}")
            return {"导出模块": f"❌ 导入失败: {e}"}
    
    def test_local_api_server(self):
        """测试本地API服务器"""
        print("\n🔍 测试本地API服务器...")
        print("=" * 50)
        
        # 测试本地API端点
        endpoints = [
            ("/", "根路径"),
            ("/export", "导出接口"),
            ("/portfolio", "投资组合"),
            ("/health", "健康检查")
        ]
        
        results = {}
        
        for endpoint, name in endpoints:
            url = f"{self.local_api}{endpoint}"
            print(f"📡 测试{name}: {url}")
            
            try:
                if endpoint == "/export":
                    # POST请求测试导出
                    test_data = {"data_type": "all"}
                    response = requests.post(url, json=test_data, timeout=5)
                else:
                    response = requests.get(url, timeout=5)
                
                if response.status_code == 200:
                    print(f"   ✅ {name} 响应正常")
                    results[name] = "✅ 正常"
                else:
                    print(f"   ⚠️ {name} 状态: HTTP {response.status_code}")
                    results[name] = f"⚠️ HTTP {response.status_code}"
                    
            except requests.exceptions.ConnectionError:
                print(f"   ❌ {name} 连接失败")
                results[name] = "❌ 连接失败"
            except Exception as e:
                print(f"   ❌ {name} 异常: {e}")
                results[name] = f"❌ 异常: {e}"
        
        return results
    
    def test_cloud_agent_api(self):
        """测试云端Agent API"""
        print("\n🔍 测试云端Agent API...")
        print("=" * 50)
        
        # 测试云端Agent相关端点
        endpoints = [
            ("/api/cloud-local-trading/local-status", "GET", "本地状态查询"),
            ("/api/cloud-local-trading/export-data", "POST", "导出数据指令"),
            ("/api/orders", "GET", "委托数据查询"),
            ("/api/trades", "GET", "成交数据查询"),
            ("/api/trading-data/upload", "POST", "交易数据上传")
        ]
        
        results = {}
        
        for endpoint, method, name in endpoints:
            url = f"{self.cloud_api}{endpoint}"
            print(f"📡 测试{name}: {method} {url}")
            
            try:
                if method == "GET":
                    response = requests.get(url, timeout=10)
                elif method == "POST":
                    if "export-data" in endpoint:
                        test_data = {
                            "data_type": "all",
                            "agent_id": "test_agent"
                        }
                    elif "trading-data" in endpoint:
                        test_data = {
                            "orders": [],
                            "trades": [],
                            "holdings": []
                        }
                    else:
                        test_data = {}
                    
                    response = requests.post(url, json=test_data, timeout=10)
                
                if response.status_code == 200:
                    result_data = response.json()
                    print(f"   ✅ {name} 成功")
                    if result_data.get('message'):
                        print(f"   📊 响应: {result_data['message']}")
                    results[name] = "✅ 成功"
                else:
                    print(f"   ❌ {name} 失败: HTTP {response.status_code}")
                    results[name] = f"❌ HTTP {response.status_code}"
                    
            except Exception as e:
                print(f"   ❌ {name} 异常: {e}")
                results[name] = f"❌ 异常: {e}"
        
        return results
    
    def test_agent_data_flow(self):
        """测试Agent数据流程"""
        print("\n🔍 测试Agent数据流程...")
        print("=" * 50)
        
        print("📋 完整的Agent数据流程:")
        print("1. 网上交易5.0导出数据 (W/E/R键)")
        print("2. 本地API服务器接收导出数据")
        print("3. Agent系统请求数据导出")
        print("4. 云端API接收Agent请求")
        print("5. 数据传输到Agent进行分析")
        
        # 模拟Agent请求数据导出
        print("\n🤖 模拟Agent请求数据导出...")
        
        try:
            # 1. Agent请求导出数据
            export_request = {
                "data_type": "all",
                "agent_id": "trading_agent_001"
            }
            
            response = requests.post(
                f"{self.cloud_api}/api/cloud-local-trading/export-data",
                json=export_request,
                timeout=10
            )
            
            if response.status_code == 200:
                result = response.json()
                print("   ✅ Agent导出请求成功")
                print(f"   📊 响应: {result.get('message', 'OK')}")
                
                # 2. 检查本地状态
                status_response = requests.get(
                    f"{self.cloud_api}/api/cloud-local-trading/local-status",
                    timeout=10
                )
                
                if status_response.status_code == 200:
                    status_data = status_response.json()
                    print("   ✅ 本地状态查询成功")
                    print(f"   📊 本地系统状态: {status_data.get('local_system_status', 'unknown')}")
                    
                    return {
                        "agent_export_request": "✅ 成功",
                        "local_status_check": "✅ 成功",
                        "data_flow": "✅ 正常"
                    }
                else:
                    return {
                        "agent_export_request": "✅ 成功",
                        "local_status_check": f"❌ HTTP {status_response.status_code}",
                        "data_flow": "⚠️ 部分异常"
                    }
            else:
                return {
                    "agent_export_request": f"❌ HTTP {response.status_code}",
                    "data_flow": "❌ 失败"
                }
                
        except Exception as e:
            return {
                "agent_export_request": f"❌ 异常: {e}",
                "data_flow": "❌ 失败"
            }
    
    def run_complete_test(self):
        """运行完整测试"""
        print("🎯 Agent数据提交系统测试")
        print("=" * 60)
        print(f"测试时间: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
        
        # 运行各项测试
        test_results = {}
        
        # 1. 测试本地导出系统
        test_results["本地导出系统"] = self.test_local_export_system()
        
        # 2. 测试本地API服务器
        test_results["本地API服务器"] = self.test_local_api_server()
        
        # 3. 测试云端Agent API
        test_results["云端Agent API"] = self.test_cloud_agent_api()
        
        # 4. 测试Agent数据流程
        test_results["Agent数据流程"] = self.test_agent_data_flow()
        
        # 生成测试报告
        self.generate_test_report(test_results)
        
        return test_results
    
    def generate_test_report(self, test_results):
        """生成测试报告"""
        print("\n📊 Agent数据提交系统测试报告")
        print("=" * 60)
        
        total_tests = 0
        passed_tests = 0
        
        for category, category_results in test_results.items():
            print(f"\n📋 {category}:")
            print("-" * 40)
            
            if isinstance(category_results, dict):
                for test_name, test_result in category_results.items():
                    total_tests += 1
                    if "✅" in str(test_result):
                        passed_tests += 1
                    print(f"   {test_name}: {test_result}")
            else:
                total_tests += 1
                if "✅" in str(category_results):
                    passed_tests += 1
                print(f"   结果: {category_results}")
        
        success_rate = (passed_tests / total_tests * 100) if total_tests > 0 else 0
        
        print(f"\n📈 测试统计:")
        print(f"   总测试数: {total_tests}")
        print(f"   通过数: {passed_tests}")
        print(f"   失败数: {total_tests - passed_tests}")
        print(f"   成功率: {success_rate:.1f}%")
        
        print(f"\n🎯 系统状态评估:")
        if success_rate >= 90:
            print("🎉 优秀 - Agent数据提交系统完全正常")
        elif success_rate >= 70:
            print("✅ 良好 - 系统基本正常，少量问题")
        elif success_rate >= 50:
            print("⚠️ 一般 - 系统部分功能正常")
        else:
            print("❌ 异常 - 系统需要修复")
        
        print(f"\n💡 使用说明:")
        print("1. 确保网上交易5.0软件正在运行")
        print("2. 使用W/E/R键导出交易数据")
        print("3. 启动本地API服务器 (localhost:8000)")
        print("4. Agent系统会自动请求和分析数据")
        print("5. 查看Agent分析结果和建议")

def main():
    """主函数"""
    tester = AgentDataSubmissionTester()
    tester.run_complete_test()

if __name__ == "__main__":
    main()
