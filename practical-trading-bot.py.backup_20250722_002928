    def get_account_info(self):
        """获取账户信息"""
        print("\n📊 获取账户信息...")
        
        if not self.find_trading_window():
            print("❌ 未找到交易窗口")
            return None
            
        if not self.activate_window():
            print("❌ 无法激活交易窗口")
            return None
        
        print("请手动切换到【资金股份】或【持仓】页面")
        input("切换完成后按回车继续...")
        
        screenshot, rect = self.take_screenshot()
        if screenshot:
            timestamp = int(time.time())
            filename = f"account_info_{timestamp}.png"
            screenshot.save(filename)
            print(f"✅ 账户信息截图已保存: {filename}")
            return filename
        
        return None
    
    def quick_trade_interface(self):
        """快速交易界面"""
        print("\n🚀 华宝证券智投版 - 快速交易界面")
        print("=" * 50)
        
        while True:
            print("\n请选择操作:")
            print("1. 买入股票")
            print("2. 卖出股票") 
            print("3. 查看账户信息")
            print("4. 退出")
            
            choice = input("\n请输入选择 (1-4): ").strip()
            
            if choice == '1':
                symbol = input("请输入股票代码: ").strip()
                quantity = input("请输入买入数量: ").strip()
                price = input("请输入买入价格: ").strip()
                
                if symbol and quantity and price:
                    self.buy_stock_manual(symbol, quantity, price)
                else:
                    print("❌ 输入信息不完整")
            
            elif choice == '2':
                symbol = input("请输入股票代码: ").strip()
                quantity = input("请输入卖出数量: ").strip()
                price = input("请输入卖出价格: ").strip()
                
                if symbol and quantity and price:
                    self.sell_stock_manual(symbol, quantity, price)
                else:
                    print("❌ 输入信息不完整")
            
            elif choice == '3':
                self.get_account_info()
            
            elif choice == '4':
                print("👋 退出交易界面")
                break
            
            else:
                print("❌ 无效选择，请重新输入")

