  console.log('   - GET  /api/virtual-account/accounts  - 虚拟账户信息');
  console.log('   - GET  /api/agent-analysis            - Agent分析状态');
  console.log('');
  console.log('💡 使用方法:');
  console.log('   1. 修改前端配置文件中的API地址为: http://localhost:3000');
  console.log('   2. 启动前端应用进行测试');
  console.log('   3. 验证所有功能正常工作');
  console.log('');
  console.log('⚠️  注意: 这是本地测试服务器，使用模拟数据');
});

// 优雅关闭
process.on('SIGINT', () => {
  console.log('\n🛑 正在关闭服务器...');
  server.close(() => {
    console.log('✅ 服务器已关闭');
    process.exit(0);
  });
});
