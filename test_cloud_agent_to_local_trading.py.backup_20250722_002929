    async def test_agent_decision_api(self):
        """测试Agent决策API"""
        self.log("🤖 测试Agent决策API...")
        
        # 测试云端Agent决策接口
        decision_tests = [
            {
                'name': '云端Agent决策接口',
                'url': f"{self.config['cloud_api_ngrok']}/api/agent/decision",
                'method': 'POST',
                'data': {
                    'stock_code': '000001',
                    'action': 'analyze',
                    'agent_id': 'test_agent'
                }
            },
            {
                'name': '本地Agent执行接口',
                'url': f"{self.config['local_api']}/api/agent/execute",
                'method': 'POST',
                'data': {
                    'action': 'buy',
                    'stock_code': '000001',
                    'quantity': 100,
                    'price': 10.50
                }
            }
        ]
        
        decision_results = {}
        
        for test in decision_tests:
            try:
                start_time = time.time()
                
                if test['method'] == 'POST':
