#!/usr/bin/env python3
"""
测试云服务Agent到本地交易后端的连接
"""

import asyncio
import websockets
import requests
import json
import time
from datetime import datetime
import logging

# 设置日志
logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')
logger = logging.getLogger(__name__)

class CloudAgentLocalTradingTester:
    def __init__(self):
        self.config = {
            # 云服务地址
            'cloud_api': 'https://aigupiao.me',
            'cloud_api_ngrok': 'https://2346443b1406.ngrok-free.app',
            'cloud_websocket': 'wss://aigupiao.me/ws',
            
            # 本地服务地址
            'local_api': 'http://localhost:8000',
            'local_trading': 'http://localhost:8888',
            
            # 测试配置
            'timeout': 15,
            'max_retries': 3
        }
        
        self.test_results = {}
    
    def log(self, message, level="INFO"):
        """记录日志"""
        timestamp = datetime.now().strftime("%H:%M:%S")
        colors = {
            "INFO": "\033[36m",
            "SUCCESS": "\033[32m",
            "WARNING": "\033[33m",
            "ERROR": "\033[31m",
            "RESET": "\033[0m"
        }
        color = colors.get(level, colors["INFO"])
        print(f"{color}[{timestamp}] [{level}] {message}{colors['RESET']}")
    
    async def test_local_services(self):
        """测试本地服务状态"""
        self.log("🖥️ 测试本地服务状态...")
        
        local_tests = [
            {'name': '本地API服务', 'url': f"{self.config['local_api']}/api/health"},
            {'name': '本地交易服务', 'url': f"{self.config['local_trading']}/health"}
        ]
        
        local_results = {}
        
        for test in local_tests:
            try:
                start_time = time.time()
                response = requests.get(test['url'], timeout=self.config['timeout'])
                latency = round((time.time() - start_time) * 1000)
                
                local_results[test['name']] = {
                    'status': 'success',
                    'latency': latency,
                    'status_code': response.status_code,
                    'response': response.json() if response.headers.get('content-type', '').startswith('application/json') else response.text[:200]
                }
                
                self.log(f"✅ {test['name']}: {latency}ms (状态码: {response.status_code})", "SUCCESS")
                
            except Exception as e:
                local_results[test['name']] = {
                    'status': 'failed',
                    'error': str(e)
                }
                self.log(f"❌ {test['name']}: 失败 - {e}", "ERROR")
        
        self.test_results['local_services'] = local_results
        return local_results
    
