# -*- coding: utf-8 -*-
"""
自动化测试交易模块
直接测试持仓导出、委托导出、成交导出、余额获取
"""

import sys
import traceback
from datetime import datetime
import os

def auto_test_holdings_export():
    """自动测试持仓导出"""
    print("🔍 自动测试持仓导出...")
    print("=" * 50)
    
    try:
        from trader_export import export_holdings
        
        print("✅ 导入export_holdings成功")
        print("🔄 开始执行持仓导出...")
        
        # 记录开始时间
        start_time = datetime.now()
        
        # 执行持仓导出
        result = export_holdings()
        
        # 记录结束时间
        end_time = datetime.now()
        duration = (end_time - start_time).total_seconds()
        
        print(f"⏱️ 执行时间: {duration:.2f} 秒")
        
        if result:
            print("✅ 持仓导出成功！")
            
            # 检查是否生成了新文件
            import glob
            holdings_files = glob.glob("持仓数据_*.csv")
            if holdings_files:
                latest_file = max(holdings_files, key=os.path.getmtime)
                file_time = datetime.fromtimestamp(os.path.getmtime(latest_file))
                if (datetime.now() - file_time).total_seconds() < 60:
                    print(f"📁 生成新文件: {latest_file}")
                    return True
            
            print("⚠️ 函数返回成功但未找到新生成的文件")
            return False
        else:
            print("❌ 持仓导出失败")
            return False
            
    except Exception as e:
        print(f"❌ 持仓导出测试异常: {e}")
        traceback.print_exc()
        return False

