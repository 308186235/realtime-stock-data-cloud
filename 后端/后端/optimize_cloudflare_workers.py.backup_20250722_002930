    def _create_performance_monitoring(self):
        """创建性能监控"""
        print("\n📈 创建性能监控...")
        
        monitoring_code = '''
// Cloudflare Workers性能监控
class WorkerPerformanceMonitor {
  constructor() {
    this.metrics = {
      requestCount: 0,
      errorCount: 0,
      totalResponseTime: 0,
      memoryUsage: [],
      cpuUsage: []
    };
    
    this.startTime = Date.now();
  }
  
  startRequest() {
    return {
      startTime: Date.now(),
      startCPU: this.getCPUTime()
    };
  }
  
  endRequest(requestContext, success = true) {
    const endTime = Date.now();
    const responseTime = endTime - requestContext.startTime;
    
    this.metrics.requestCount++;
    this.metrics.totalResponseTime += responseTime;
    
    if (!success) {
      this.metrics.errorCount++;
    }
    
    // 记录性能指标
    this.recordMetrics(responseTime, requestContext);
    
    return {
      responseTime,
      success
    };
  }
  
  recordMetrics(responseTime, context) {
    // CPU使用情况
    const cpuTime = this.getCPUTime() - context.startCPU;
    this.metrics.cpuUsage.push({
      timestamp: Date.now(),
      cpuTime,
      responseTime
    });
    
    // 保持最近100条记录
    if (this.metrics.cpuUsage.length > 100) {
      this.metrics.cpuUsage.shift();
    }
    
    // 内存使用估算
    const memoryEstimate = this.estimateMemoryUsage();
    this.metrics.memoryUsage.push({
      timestamp: Date.now(),
      memory: memoryEstimate
    });
    
    if (this.metrics.memoryUsage.length > 100) {
      this.metrics.memoryUsage.shift();
    }
  }
  
  getCPUTime() {
    // Worker环境中的CPU时间估算
    return performance.now();
  }
  
  estimateMemoryUsage() {
    // 简单的内存使用估算
    return JSON.stringify(this.metrics).length;
  }
  
  getPerformanceReport() {
    const uptime = Date.now() - this.startTime;
    const avgResponseTime = this.metrics.requestCount > 0 
      ? this.metrics.totalResponseTime / this.metrics.requestCount 
      : 0;
    
    const errorRate = this.metrics.requestCount > 0 
      ? (this.metrics.errorCount / this.metrics.requestCount) * 100 
      : 0;
    
    return {
      uptime,
      requestCount: this.metrics.requestCount,
      errorCount: this.metrics.errorCount,
      errorRate: errorRate.toFixed(2) + '%',
      avgResponseTime: avgResponseTime.toFixed(2) + 'ms',
      currentMemoryEstimate: this.estimateMemoryUsage(),
      recentCPUUsage: this.getRecentCPUUsage(),
      status: this.getHealthStatus()
    };
  }
  
  getRecentCPUUsage() {
    if (this.metrics.cpuUsage.length === 0) return 0;
    
    const recent = this.metrics.cpuUsage.slice(-10);
    const avgCPU = recent.reduce((sum, item) => sum + item.cpuTime, 0) / recent.length;
    return avgCPU.toFixed(2);
  }
  
  getHealthStatus() {
    const errorRate = this.metrics.requestCount > 0 
      ? (this.metrics.errorCount / this.metrics.requestCount) * 100 
      : 0;
    
    const avgResponseTime = this.metrics.requestCount > 0 
      ? this.metrics.totalResponseTime / this.metrics.requestCount 
      : 0;
    
    if (errorRate > 10 || avgResponseTime > 5000) {
      return 'CRITICAL';
    } else if (errorRate > 5 || avgResponseTime > 2000) {
      return 'WARNING';
    } else {
      return 'HEALTHY';
    }
  }
  
  reset() {
    this.metrics = {
      requestCount: 0,
      errorCount: 0,
      totalResponseTime: 0,
      memoryUsage: [],
      cpuUsage: []
    };
    this.startTime = Date.now();
  }
}

// 全局性能监控器
const performanceMonitor = new WorkerPerformanceMonitor();

// 性能监控中间件
function withPerformanceMonitoring(handler) {
  return async (request, env, ctx) => {
    const requestContext = performanceMonitor.startRequest();
    let success = true;
    
    try {
      const response = await handler(request, env, ctx);
      return response;
    } catch (error) {
      success = false;
      throw error;
    } finally {
      performanceMonitor.endRequest(requestContext, success);
    }
  };
}
'''
        
        monitoring_file = "cloudflare-performance-monitor.js"
        with open(monitoring_file, 'w', encoding='utf-8') as f:
            f.write(monitoring_code)
        
        self.optimized_files.append(monitoring_file)
        print(f"✅ 创建性能监控系统: {monitoring_file}")
    
    def _backup_file(self, file_path: str):
        """备份文件"""
        if not os.path.exists(file_path):
            return
            
        backup_name = file_path.replace("/", "_").replace("\\", "_") + ".backup"
        backup_path = os.path.join(self.backup_dir, backup_name)
        
        try:
            shutil.copy2(file_path, backup_path)
        except Exception as e:
            print(f"⚠️ 备份失败 {file_path}: {e}")
    
    def _optimize_worker_cpu(self, worker_file: str):
        """优化Worker CPU使用"""
        try:
            self._backup_file(worker_file)
            
            with open(worker_file, 'r', encoding='utf-8') as f:
                content = f.read()
            
            # CPU优化替换
            optimizations = [
                # 避免同步循环
                (r'for\s*\(\s*let\s+\w+\s*=\s*0\s*;\s*\w+\s*<\s*\w+\.length\s*;\s*\w+\+\+\s*\)', 
                 'for (const item of items) { // 优化: 使用for-of循环'),
                
                # 添加异步处理
                (r'function\s+(\w+)\s*\([^)]*\)\s*{', 
                 r'async function \1() { // 优化: 异步处理'),
                
                # 添加CPU时间检查
                (r'(while\s*\([^)]+\)\s*{)', 
                 r'\1\n    // CPU时间检查\n    if (Date.now() - startTime > 5000) break;')
            ]
            
            for pattern, replacement in optimizations:
                content = re.sub(pattern, replacement, content)
            
            # 添加性能监控导入
            if 'performanceMonitor' not in content:
                performance_import = '''
// 性能监控
import { performanceMonitor, withPerformanceMonitoring } from './cloudflare-performance-monitor.js';
'''
                content = performance_import + content
            
            with open(worker_file, 'w', encoding='utf-8') as f:
                f.write(content)
            
            self.optimized_files.append(worker_file)
            print(f"✅ 优化Worker CPU: {worker_file}")
            
        except Exception as e:
            print(f"⚠️ 优化Worker失败 {worker_file}: {e}")

