// 内存优化的Worker模板
class MemoryOptimizedWorker {
  constructor() {
    this.cache = new Map();
    this.maxCacheSize = 100; // 限制缓存大小
    this.requestCount = 0;
  }
  
  // 内存安全的数据处理
  processDataSafely(data) {
    try {
      // 分批处理大数据
      if (Array.isArray(data) && data.length > 1000) {
        return this.processBatches(data, 100);
      }
      
      // 清理不必要的对象引用
      const result = this.processSmallData(data);
      
      // 强制垃圾回收提示
      if (this.requestCount % 10 === 0) {
        this.cleanupCache();
      }
      
      return result;
    } catch (error) {
      console.error('数据处理错误:', error);
      return null;
    }
  }
  
  processBatches(data, batchSize) {
    const results = [];
    for (let i = 0; i < data.length; i += batchSize) {
      const batch = data.slice(i, i + batchSize);
      const batchResult = this.processSmallData(batch);
      results.push(batchResult);
      
      // 每批处理后清理临时变量
      batch.length = 0;
    }
    return results;
  }
  
  processSmallData(data) {
    // 实际数据处理逻辑
    return data;
  }
  
  cleanupCache() {
    if (this.cache.size > this.maxCacheSize) {
      const keysToDelete = Array.from(this.cache.keys()).slice(0, this.cache.size - this.maxCacheSize);
      keysToDelete.forEach(key => this.cache.delete(key));
    }
  }
  
  // 内存安全的缓存操作
  setCache(key, value) {
    if (this.cache.size >= this.maxCacheSize) {
      const firstKey = this.cache.keys().next().value;
      this.cache.delete(firstKey);
    }
    this.cache.set(key, value);
  }
  
  getCache(key) {
    return this.cache.get(key);
  }
}

// 全局实例
const memoryOptimizedWorker = new MemoryOptimizedWorker();
'''
        
