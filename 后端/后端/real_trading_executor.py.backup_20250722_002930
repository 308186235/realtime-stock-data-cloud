#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
真实交易执行器
基于交易软件界面的真实买卖操作
"""

import time
import win32gui
import win32con
import win32api
import win32clipboard
from datetime import datetime
import pyautogui

class RealTradingExecutor:
    """真实交易执行器"""
    
    def __init__(self):
        self.window_handle = None
        self.window_title_patterns = [
            "网上股票交易系统",
            "东吴证券",
            "股票交易"
        ]
        pyautogui.FAILSAFE = False
    
    def find_and_activate_trading_window(self):
        """查找并激活交易软件窗口"""
        print("🔍 查找交易软件窗口...")
        
        def enum_callback(hwnd, windows):
            if win32gui.IsWindowVisible(hwnd):
                title = win32gui.GetWindowText(hwnd)
                for pattern in self.window_title_patterns:
                    if pattern in title:
                        windows.append((hwnd, title))
            return True
        
        windows = []
        win32gui.EnumWindows(enum_callback, windows)
        
        if not windows:
            print("❌ 未找到交易软件窗口")
            return False
        
        self.window_handle, window_title = windows[0]
        print(f"✅ 找到交易软件: {window_title}")
        
        try:
            # 恢复窗口（如果最小化）
            if win32gui.IsIconic(self.window_handle):
                win32gui.ShowWindow(self.window_handle, win32con.SW_RESTORE)
                time.sleep(1)
            
            # 激活窗口
            win32gui.SetForegroundWindow(self.window_handle)
            time.sleep(0.5)
            print("✅ 交易软件已激活")
            return True
            
        except Exception as e:
            print(f"⚠️ 激活窗口失败: {e}")
            return False
    
    def send_key(self, key_code, hold_time=0.1):
        """发送按键"""
        try:
            win32api.keybd_event(key_code, 0, 0, 0)  # 按下
            time.sleep(hold_time)
            win32api.keybd_event(key_code, 0, win32con.KEYEVENTF_KEYUP, 0)  # 释放
            time.sleep(0.2)
            return True
        except Exception as e:
            print(f"❌ 发送按键失败: {e}")
            return False
    
    def send_text_via_clipboard(self, text):
        """通过剪贴板输入文本"""
        try:
            # 打开剪贴板
            win32clipboard.OpenClipboard()
            win32clipboard.EmptyClipboard()
            win32clipboard.SetClipboardText(str(text))
            win32clipboard.CloseClipboard()
            
            # 全选并粘贴
            win32api.keybd_event(win32con.VK_CONTROL, 0, 0, 0)  # Ctrl按下
            win32api.keybd_event(ord('A'), 0, 0, 0)  # A按下
            win32api.keybd_event(ord('A'), 0, win32con.KEYEVENTF_KEYUP, 0)  # A释放
            win32api.keybd_event(win32con.VK_CONTROL, 0, win32con.KEYEVENTF_KEYUP, 0)  # Ctrl释放
            
            time.sleep(0.2)
            
            win32api.keybd_event(win32con.VK_CONTROL, 0, 0, 0)  # Ctrl按下
            win32api.keybd_event(ord('V'), 0, 0, 0)  # V按下
            win32api.keybd_event(ord('V'), 0, win32con.KEYEVENTF_KEYUP, 0)  # V释放
            win32api.keybd_event(win32con.VK_CONTROL, 0, win32con.KEYEVENTF_KEYUP, 0)  # Ctrl释放
            
            time.sleep(0.3)
            print(f"✅ 文本输入成功: {text}")
            return True
            
        except Exception as e:
            print(f"❌ 文本输入失败: {e}")
            return False
    
    def execute_buy_order(self, stock_code, price, quantity, confirm=False):
        """执行买入订单"""
        print(f"🛒 执行买入订单: {stock_code} {quantity}股 @{price}元")
        print("=" * 50)
        
        try:
            # 1. 激活交易软件
            if not self.find_and_activate_trading_window():
                return {
                    "success": False,
                    "message": "无法找到或激活交易软件",
                    "error_type": "window_not_found"
                }
            
            # 2. 按F1进入买卖页面
            print("1️⃣ 按F1进入买卖页面...")
            if not self.send_key(win32con.VK_F1):
                return {
                    "success": False,
                    "message": "无法进入买卖页面",
                    "error_type": "navigation_failed"
                }
            time.sleep(1)
            
            # 3. 输入股票代码
            print(f"2️⃣ 输入股票代码: {stock_code}")
            if not self.send_text_via_clipboard(stock_code):
                return {
                    "success": False,
                    "message": "股票代码输入失败",
                    "error_type": "input_failed"
                }
            
            # 按Tab切换到价格字段
            self.send_key(win32con.VK_TAB)
            time.sleep(0.5)
            
            # 4. 输入价格
            print(f"3️⃣ 输入价格: {price}")
            if not self.send_text_via_clipboard(f"{price:.2f}"):
                return {
                    "success": False,
                    "message": "价格输入失败",
                    "error_type": "input_failed"
                }
            
            # 按Tab切换到数量字段
            self.send_key(win32con.VK_TAB)
            time.sleep(0.5)
            
            # 5. 输入数量
            print(f"4️⃣ 输入数量: {quantity}")
            if not self.send_text_via_clipboard(str(quantity)):
                return {
                    "success": False,
                    "message": "数量输入失败",
                    "error_type": "input_failed"
                }
            
            # 6. 确认买入
            if confirm:
                print("5️⃣ 确认买入...")
                # 按Enter或点击买入按钮
                self.send_key(win32con.VK_RETURN)
                time.sleep(1)
                
                # 可能需要再次确认
                self.send_key(win32con.VK_RETURN)
                time.sleep(1)
                
                order_id = f"BUY_{stock_code}_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
                
                return {
                    "success": True,
                    "data": {
                        "order_id": order_id,
                        "stock_code": stock_code,
                        "price": price,
                        "quantity": quantity,
                        "total_amount": price * quantity,
                        "status": "SUBMITTED",
                        "message": "买入订单已提交"
                    },
                    "timestamp": datetime.now().isoformat()
                }
            else:
                print("5️⃣ 买入信息已填入，等待手动确认")
                
                order_id = f"PENDING_BUY_{stock_code}_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
                
                return {
                    "success": True,
                    "data": {
                        "order_id": order_id,
                        "stock_code": stock_code,
                        "price": price,
                        "quantity": quantity,
                        "total_amount": price * quantity,
                        "status": "PENDING_CONFIRM",
                        "message": "买入信息已填入，等待手动确认"
                    },
                    "timestamp": datetime.now().isoformat()
                }
                
        except Exception as e:
            print(f"❌ 买入操作异常: {e}")
            return {
                "success": False,
                "message": f"买入操作异常: {str(e)}",
                "error_type": "execution_error"
            }
    
