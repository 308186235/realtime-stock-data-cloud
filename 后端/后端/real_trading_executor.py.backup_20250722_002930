    def execute_cancel_order(self, order_id=None):
        """执行撤单操作"""
        print(f"🚫 执行撤单操作: {order_id}")
        print("=" * 50)
        
        try:
            # 1. 激活交易软件
            if not self.find_and_activate_trading_window():
                return {
                    "success": False,
                    "message": "无法找到或激活交易软件",
                    "error_type": "window_not_found"
                }
            
            # 2. 按F3进入撤单页面
            print("1️⃣ 按F3进入撤单页面...")
            if not self.send_key(win32con.VK_F3):
                return {
                    "success": False,
                    "message": "无法进入撤单页面",
                    "error_type": "navigation_failed"
                }
            time.sleep(1)
            
            # 3. 选择要撤销的订单（通常是选择第一个未成交的订单）
            print("2️⃣ 选择要撤销的订单...")
            # 按空格键选择订单
            self.send_key(win32con.VK_SPACE)
            time.sleep(0.5)
            
            # 4. 确认撤单
            print("3️⃣ 确认撤单...")
            self.send_key(win32con.VK_RETURN)
            time.sleep(1)
            
            # 可能需要再次确认
            self.send_key(win32con.VK_RETURN)
            time.sleep(1)
            
            return {
                "success": True,
                "data": {
                    "order_id": order_id or f"CANCEL_{datetime.now().strftime('%Y%m%d_%H%M%S')}",
                    "status": "CANCELLED",
                    "message": "订单已撤销"
                },
                "timestamp": datetime.now().isoformat()
            }
            
        except Exception as e:
            print(f"❌ 撤单操作异常: {e}")
            return {
                "success": False,
                "message": f"撤单操作异常: {str(e)}",
                "error_type": "execution_error"
            }

