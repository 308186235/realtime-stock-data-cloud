#!/usr/bin/env python3
"""
简单的监控服务 - 端口8002
用于测试Zero Trust隧道配置
"""
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
import uvicorn
import os
import psutil
import json
import logging
from datetime import datetime
from typing import Dict, Any

# 配置日志
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

app = FastAPI(
    title="System Monitoring Service",
    description="系统监控服务",
    version="1.0.0"
)

# 添加CORS中间件
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

def get_system_metrics() -> Dict[str, Any]:
    """获取系统指标"""
    try:
        # CPU使用率
        cpu_percent = psutil.cpu_percent(interval=1)
        
        # 内存使用情况
        memory = psutil.virtual_memory()
        
        # 磁盘使用情况
        disk = psutil.disk_usage('/')
        
        # 网络统计
        network = psutil.net_io_counters()
        
        return {
            "timestamp": datetime.now().isoformat(),
            "cpu": {
                "usage_percent": cpu_percent,
                "count": psutil.cpu_count(),
                "count_logical": psutil.cpu_count(logical=True)
            },
            "memory": {
                "total": memory.total,
                "available": memory.available,
                "used": memory.used,
                "usage_percent": memory.percent
            },
            "disk": {
                "total": disk.total,
                "used": disk.used,
                "free": disk.free,
                "usage_percent": (disk.used / disk.total) * 100
            },
            "network": {
                "bytes_sent": network.bytes_sent,
                "bytes_recv": network.bytes_recv,
                "packets_sent": network.packets_sent,
                "packets_recv": network.packets_recv
            }
        }
    except Exception as e:
        logger.error(f"获取系统指标失败: {e}")
        return {
            "timestamp": datetime.now().isoformat(),
            "error": str(e),
            "status": "error"
        }

@app.get("/")
async def root():
    """根路径"""
    return {
        "service": "System Monitoring Service",
        "status": "running",
        "port": int(os.getenv("PORT", 8002)),
        "timestamp": datetime.now().isoformat(),
        "description": "系统监控服务 (monitor.aigupiao.me)",
        "endpoints": [
            "/health",
            "/api/metrics/current",
            "/api/metrics/system",
            "/api/services/status"
        ]
    }

@app.get("/health")
async def health_check():
    """健康检查"""
    return {
        "status": "healthy",
        "service": "monitoring",
        "timestamp": datetime.now().isoformat(),
        "port": int(os.getenv("PORT", 8002))
    }

@app.get("/api/metrics/current")
async def get_current_metrics():
    """获取当前系统指标"""
    return get_system_metrics()

@app.get("/api/metrics/system")
async def get_system_info():
    """获取系统信息"""
    try:
        boot_time = datetime.fromtimestamp(psutil.boot_time())
        
        return {
            "timestamp": datetime.now().isoformat(),
            "system": {
                "platform": os.name,
                "boot_time": boot_time.isoformat(),
                "uptime_seconds": (datetime.now() - boot_time).total_seconds()
            },
            "python": {
                "version": os.sys.version,
                "executable": os.sys.executable
            },
            "process": {
                "pid": os.getpid(),
                "cwd": os.getcwd(),
                "user": os.getenv("USERNAME", "unknown")
            }
        }
    except Exception as e:
        logger.error(f"获取系统信息失败: {e}")
        return {
            "timestamp": datetime.now().isoformat(),
            "error": str(e),
            "status": "error"
        }

@app.get("/api/services/status")
async def get_services_status():
    """获取服务状态"""
    services = {}
    
    # 检查常见端口的服务状态
    ports_to_check = [8000, 8001, 8002, 8003, 8888, 9999, 2000, 5000, 6379]
    
    for port in ports_to_check:
        try:
            import socket
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
                s.settimeout(1)
                result = s.connect_ex(('localhost', port))
                services[f"port_{port}"] = {
                    "port": port,
                    "status": "running" if result == 0 else "stopped",
                    "checked_at": datetime.now().isoformat()
                }
        except Exception as e:
            services[f"port_{port}"] = {
                "port": port,
                "status": "error",
                "error": str(e),
                "checked_at": datetime.now().isoformat()
            }
    
    return {
        "timestamp": datetime.now().isoformat(),
        "services": services,
        "total_services": len(services),
        "running_services": len([s for s in services.values() if s.get("status") == "running"])
    }

@app.get("/api/metrics/history")
async def get_metrics_history():
    """获取历史指标（模拟数据）"""
    # 生成最近10个时间点的模拟数据
    history = []
    for i in range(10):
        timestamp = datetime.now().timestamp() - (i * 60)  # 每分钟一个数据点
        history.append({
            "timestamp": datetime.fromtimestamp(timestamp).isoformat(),
            "cpu_percent": 20 + (i % 5) * 10,
            "memory_percent": 60 + (i % 3) * 5,
            "disk_percent": 45 + (i % 2) * 2
        })
    
    return {
        "timestamp": datetime.now().isoformat(),
        "history": list(reversed(history)),  # 按时间正序排列
        "count": len(history)
    }

@app.on_event("startup")
async def startup_event():
    """启动时的事件"""
    logger.info("🚀 系统监控服务启动完成")
    logger.info(f"📊 监控端点: http://localhost:{os.getenv('PORT', 8002)}/api/metrics/current")
    logger.info(f"🔍 服务状态: http://localhost:{os.getenv('PORT', 8002)}/api/services/status")

if __name__ == "__main__":
    PORT = int(os.getenv("PORT", 8002))
    logger.info(f"启动系统监控服务，端口: {PORT}")
    uvicorn.run(
        "simple_monitoring_service:app",
        host="0.0.0.0",
        port=PORT,
        log_level="info",
        access_log=True
    )
