    def find_trading_window(self):
        """查找交易窗口"""
        def enum_windows_callback(hwnd, windows):
            if win32gui.IsWindowVisible(hwnd):
                window_text = win32gui.GetWindowText(hwnd)
                if "同花顺" in window_text or "交易" in window_text:
                    self.window_hwnd = hwnd
                    return False
            return True
        
        win32gui.EnumWindows(enum_windows_callback, [])
        return self.window_hwnd is not None
    
    def activate_window(self):
        """激活交易窗口"""
        if self.window_hwnd:
            win32gui.SetForegroundWindow(self.window_hwnd)
            time.sleep(0.5)
            return True
        return False
    
    def click_control(self, control_type):
        """点击指定类型的控件"""
        for control in self.controls:
            if control['type'] == control_type:
                rect = control['rect']
                x = (rect[0] + rect[2]) // 2
                y = (rect[1] + rect[3]) // 2
                pyautogui.click(x, y)
                time.sleep(0.2)
                return True
        return False
    
    def input_text(self, control_type, text):
        """在指定控件中输入文本"""
        if self.click_control(control_type):
            pyautogui.hotkey('ctrl', 'a')  # 全选
            time.sleep(0.1)
            pyautogui.typewrite(str(text))
            time.sleep(0.2)
            return True
        return False
    
    def buy_stock(self, symbol, quantity, price):
        """买入股票"""
        try:
            if not self.find_trading_window():
                print("未找到交易窗口")
                return False
                
            if not self.activate_window():
                print("无法激活交易窗口")
                return False
            
            # 点击买入按钮
            if not self.click_control('buy_button'):
                print("未找到买入按钮")
                return False
            
            # 输入股票代码
            if not self.input_text('symbol_input', symbol):
                print("无法输入股票代码")
                return False
            
            # 输入数量
            if not self.input_text('quantity_input', quantity):
                print("无法输入数量")
                return False
            
            # 输入价格
            if not self.input_text('price_input', price):
                print("无法输入价格")
                return False
            
            # 确认买入
            if not self.click_control('confirm_button'):
                print("无法点击确认按钮")
                return False
            
            print(f"买入操作完成: {symbol} {quantity}股 @{price}")
            return True
            
        except Exception as e:
            print(f"买入操作失败: {e}")
            return False
    
