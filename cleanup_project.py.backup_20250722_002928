        'backup_api_service.py',          # 备份API服务
    }
    
    # 要删除的文件类型
    delete_patterns = [
        '*.backup_*',           # 备份文件
        '*.syntax_backup_*',    # 语法备份
        '*_backup_*',           # 各种备份
        '*.pyc',                # Python缓存
        '*.log',                # 日志文件
        '*.tmp',                # 临时文件
        '*.cache',              # 缓存文件
        '*.old',                # 旧文件
